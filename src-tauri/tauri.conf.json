{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteSpace",
  "version": "0.1.0",
  "identifier": "com.notespace.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5180 --strictPort",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoteSpace",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "3D-база знаний",
    "longDescription": "NoteSpace — 3D-база знаний: вложенные группы и записи, связи, уровни и теги.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
